# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Client ID de Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Debe coincidir con el configurado en el backend (GOOGLE_CLIENT_ID en MS-Usuarios).
# Authorized JavaScript origins debe incluir el origen desde donde sirvas el frontend:
#   - http://localhost:5173 (Vite dev)
#   - https://agreeable-ground-0b1436910.6.azurestaticapps.net (Azure SWA prod)
VITE_GOOGLE_CLIENT_ID=703304000101-f5ku79ld8mejv04dkfqt4ejbilm4dv66.apps.googleusercontent.com

# ─── GitHub OAuth ────────────────────────────────────────────────────────────────
# Client ID de GitHub OAuth (https://github.com/settings/applications/new)
# Authorization callback URL debe coincidir EXACTO con el frontend:
#   - http://localhost:5173/auth/github/callback (Vite dev)
#   - https://agreeable-ground-0b1436910.6.azurestaticapps.net/auth/github/callback (Azure SWA prod)
# Scopes requeridos: read:user, user:email
VITE_GITHUB_CLIENT_ID=Iv1.your_github_oauth_app_client_id

# ─── API REST ──────────────────────────────────────────────────────────────────
# Por default el cliente pega '/api/...'. El SWA proxia ese prefijo al App Service
# (linked backend) → mismo origen para el browser, sin CORS.
# Override solo si querés deslinkear el SWA y hablarle directo al backend.
# VITE_API_PREFIX=/api
# VITE_API_URL=https://arrendamientos-ms-users-boot.azurewebsites.net
# VITE_APIM_URL=                                                # deprecado, dejar vacío
# VITE_APIM_SUBSCRIPTION_KEY=                                   # deprecado, dejar vacío

# ─── Tiempo real — Microservicio Mensajes (Socket.io) ─────────────────────────
# URL directa del App Service de mensajes (SIN /api — Socket.io se conecta a la raíz).
# Ejemplo: https://ms-mensajes.azurewebsites.net
VITE_SOCKET_URL=https://ms-mensajes.azurewebsites.net

# ─── Tiempo real — Microservicio Notificaciones (WebSocket nativo) ────────────
# Solo el hostname (sin protocolo). El hook construye la URL completa:
#   wss://{VITE_NOTIF_WS_URL}/ws/{userId}?token={jwt}
# Ejemplo: ms-notificaciones.azurewebsites.net
VITE_NOTIF_WS_URL=ms-notificaciones.azurewebsites.net

# ─── JWT (compartido con los microservicios) ──────────────────────────────────
# Secreto HS256 para firmar tokens JWT en el cliente.
# Debe coincidir con JWT_SECRET configurado en ms-mensajes y ms-notificaciones.
# ⚠️  Para producción real, considerar RS256 + JWKS para no exponer el secreto.
VITE_JWT_SECRET=secret_seguro_aqui_123456789
